{
  "name": "@meridian/sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "tsc --build --clean --project tsconfig.json",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage --reporter=html --reporter=text",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "typescript": "~5.3.0"
  },
  "devDependencies": {
    "vitest": "~1.6.0",
    "@vitest/coverage-v8": "~1.6.0"
  }
}